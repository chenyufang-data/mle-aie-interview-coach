# Copy this file to .env and fill in your key:
#   copy .env.sample .env        (Windows)
#   cp .env.sample .env          (macOS / Linux)
#
# The key is only required for the default Claude-graded mode.
# `python server.py --mock` and `python server.py --ollama` need no key at all.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown):
# ANTHROPIC_MODEL=claude-opus-4-8
# PORT=8000

# Freemium tiers (active only when users.json exists - see users.sample.json):
# PAID_DAILY_QUOTA=30

# Optional paid-tier workhorse judge (tiered mode): with a DeepSeek key, paid
# evaluations default to DeepSeek V4 Flash quota-free (measured judge - see
# grader/judge_agreement.py); Claude then serves only "Always Claude" requests
# under PAID_DAILY_QUOTA. Leave unset for all-Claude paid routing.
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_MODEL=deepseek-v4-flash
