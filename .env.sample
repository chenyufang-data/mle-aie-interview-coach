# Copy this file to .env and fill in your key:
#   copy .env.sample .env        (Windows)
#   cp .env.sample .env          (macOS / Linux)
#
# The key is only required for the default Claude-graded mode.
# `python server.py --mock` and `python server.py --ollama` need no key at all.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown):
# ANTHROPIC_MODEL=claude-opus-4-8
# PORT=8000

# Freemium tiers (active only when users.json exists - see users.sample.json):
# PAID_DAILY_QUOTA=30

# Optional paid-tier workhorse judge (tiered mode): with a DeepSeek key, paid
# evaluations default to DeepSeek V4 Flash quota-free (measured judge - see
# grader/judge_agreement.py); Claude then serves only "Always Claude" requests
# under PAID_DAILY_QUOTA. Leave unset for all-Claude paid routing.
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Live voice mode (python server.py --voice) - all optional ----
# Audio backend for the live loop: local (default; faster-whisper + Kokoro,
# models in data/models/), speaches (local HTTP server), deepgram, or
# elevenlabs. STT_BACKEND / TTS_BACKEND override the bundle half-by-half
# (e.g. local STT + Deepgram TTS). Measured comparison: docs/backend.md.
# AUDIO_BACKEND=local
# STT_BACKEND=
# TTS_BACKEND=
# SPEACHES_URL=http://127.0.0.1:8100

# Cloud voice keys (only needed for the matching backend / Level 1):
# ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
# DEEPGRAM_API_KEY=your-deepgram-key-here
# SPEECH_ENGINE_ID=seng_your-speech-engine-id   (Level 1 hosted voice)

# Voice tuning (defaults shown; measured in docs/mock_interview_plan.md):
# VOICE_PORT=8765
# VOICE_END_SILENCE_MS=2000
# FINAL_STT=            (force the post-session transcript engine)
# TTS_VOICE=            (local Kokoro voice)
# ELEVEN_TTS_VOICE=     (ElevenLabs voice id)
# DEEPGRAM_TTS_VOICE=aura-2-thalia-en
