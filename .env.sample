# Copy this file to .env and fill in your key:
#   copy .env.sample .env        (Windows)
#   cp .env.sample .env          (macOS / Linux)
#
# The key is only required for the default Claude-graded mode.
# `python server.py --mock` and `python server.py --ollama` need no key at all.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown):
# ANTHROPIC_MODEL=claude-opus-4-8
# PORT=8000

# Freemium tiers (active only when users.json exists - see users.sample.json):
# PAID_DAILY_QUOTA=30

# State store (coach/store.py). Unset: keys, counters, session logs and the
# plan cache are files (users.json, data/). Set: the same state in Postgres,
# tiers always on, users.json imported by tools/migrate_to_postgres.py.
# Needs `pip install -r requirements-db.txt`. In Docker, set POSTGRES_PASSWORD
# instead and start with docker-compose.db.yml, which builds DATABASE_URL.
# DATABASE_URL=postgresql://coach:password@127.0.0.1:5432/coach
# POSTGRES_PASSWORD=change-me
# USERS_REFRESH_S=5
# Where the hybrid retriever's vectors are served from: auto (pgvector when
# the Postgres store is on, else the in-process matrix), numpy, pgvector.
# RETRIEVAL_VECTORS=auto

# Optional paid-tier workhorse judge (tiered mode): with a DeepSeek key, paid
# evaluations default to DeepSeek V4 Flash quota-free (measured judge - see
# grader/judge_agreement.py); Claude then serves only "Always Claude" requests
# under PAID_DAILY_QUOTA. Leave unset for all-Claude paid routing.
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Jev scorer for the free tier (roadmap step 6, coach/jev.py): with
# a TypeSafe key and outside --mock, the free tier's grade and rubric verdicts
# come from Jev (calibrated; measured in experiments/jev/), bounded by a
# server-wide daily cap (0 = unlimited); a spent cap, an error or a timeout
# keeps the local sklearn grade. JEV_MODEL pins a version (empty = the one
# coach/assets/jev_calibration.json was fitted for).
# TYPESAFE_API_KEY=your-typesafe-key-here
# JEV_DAILY_CAP=500
# JEV_MODEL=
# JEV_TIMEOUT_S=3

# Local subscription engine (python server.py --cli claude|codex, coach/cli_engine.py):
# every LLM call goes through your own signed-in Claude Code or Codex CLI instead of
# an API key. Loopback only. Model and effort are explicit (empty model = Sonnet for
# Claude Code, your Codex default for Codex); the timeout bounds one CLI call.
# With no mode flag on localhost, a signed-in CLI is used automatically:
# LLM_CLI=auto (Claude Code first) | codex (Codex first) | off (API keys).
# LLM_CLI=auto
# LLM_CLI_MODEL=
# LLM_CLI_EFFORT=low
# LLM_CLI_TIMEOUT_S=300
# The coding tutor's quick replies on another model (e.g. sonnet: hint p95 3.6 s against
# 5.2 s on Opus, experiments/coding/); empty = the same model as everything else.
# LLM_CLI_QUICK_MODEL=

# Coding drills (coach/coding.py): on a localhost bind, Run executes your code with
# this Python in a temporary folder (no API keys in its environment). Off on any
# other HOST; CODE_RUN=off turns it off locally too.
# CODE_RUN=on
# CODE_RUN_TIMEOUT_S=10

# ---- Live voice mode (python server.py --voice) - all optional ----
# Audio backend for the live loop: local (default; faster-whisper + Kokoro,
# models in data/models/), speaches (local HTTP server), deepgram, or
# elevenlabs. STT_BACKEND / TTS_BACKEND override the bundle half-by-half
# (e.g. local STT + Deepgram TTS). Measured comparison: docs/backend.md.
# AUDIO_BACKEND=local
# STT_BACKEND=
# TTS_BACKEND=
# SPEACHES_URL=http://127.0.0.1:8100

# Cloud voice keys (only needed for the matching backend / Level 1):
# ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
# DEEPGRAM_API_KEY=your-deepgram-key-here
# SPEECH_ENGINE_ID=seng_your-speech-engine-id   (Level 1 hosted voice)

# Voice tuning (defaults shown; measured in docs/mock_interview_plan.md):
# VOICE_PORT=8765
# VOICE_END_SILENCE_MS=2000
# FINAL_STT=            (force the post-session transcript engine)
# TTS_VOICE=            (local Kokoro voice)
# ELEVEN_TTS_VOICE=     (ElevenLabs voice id)
# DEEPGRAM_TTS_VOICE=aura-2-thalia-en
